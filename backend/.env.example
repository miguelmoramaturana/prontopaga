# Puerto donde escucha la API
PORT=3000

# Secreto para firmar/verificar los JWT (cámbialo en cualquier entorno real)
JWT_SECRET=super-secreto-solo-para-desarrollo

# Vigencia del token (formato de la librería `ms`: 15m, 1h, 7d, o segundos)
JWT_EXPIRES_IN=1h

# Origen permitido para CORS (la SPA de Vite)
CORS_ORIGIN=http://localhost:5173
